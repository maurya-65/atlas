# Anthropic API key (preferred name; wins over a stale shell ANTHROPIC_API_KEY)
ATLAS_ANTHROPIC_API_KEY=

# SnapTrade (https://dashboard.snaptrade.com -> API keys)
SNAPTRADE_CLIENT_ID=
SNAPTRADE_CONSUMER_KEY=
# "personal" (default: keys from the SnapTrade dashboard, brokerages linked there) or "commercial" (app keys)
SNAPTRADE_AUTH_MODE=personal
# Optional: jump straight to one broker in the connection portal, e.g. ALPACA-PAPER
SNAPTRADE_BROKER=

# Optional: SEC asks for a contact in the User-Agent
SEC_USER_AGENT=Atlas hackathon demo you@example.com

# ---- Only needed when Atlas runs on a public host (see "Deploy to Vercel" in README.md) ----

# Sign-in password. A hosted copy refuses to serve anything without it.
ATLAS_PASSWORD=
# Optional: sign-in asks for this username too.
ATLAS_USERNAME=
# Optional: 1 prints the username and password under the sign-in form, for a demo copy shared with reviewers.
ATLAS_SHOW_LOGIN=
# Any long random string. Vercel sends it with each call to /api/cron/daily.
CRON_SECRET=
# Upstash Redis, for hosts with no writable disk. Vercel's Upstash integration fills these in.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# The deployment's address, for the notes the MCP server gives Claude (default http://localhost:3000).
ATLAS_APP_URL=
